  m_Script: {fileID: 11500000, guid: 002b9076b5a919941a76b7b86978d20e, type: 3}
  m_Name: 00_Opening
  m_EditorClassIdentifier: Assembly-CSharp::Conversation
  showPanel: 1
  panelImage: {fileID: 0}
  panelColor: {r: 0.06, g: 0.07, b: 0.13, a: 1}
  panelTitle: Mid-Autumn Night
  Lines:
  - text: The Mid-Autumn moon hangs pale behind the bakery window. The Baker discovers
      Artemis curled beside an old, cracked mooncake mold.
    npcId: 0
    style: 3
    speakerName: 
    panelImage: {fileID: 0}
  - text: There you are. I wondered who kept sleeping beneath my window.
    npcId: 1
    style: 0
    speakerName: 
    panelImage: {fileID: 0}
  - text: You chose a strange night to visit. Even the moon seems to have forgotten
      how to shine.
    npcId: 1
    style: 0
    speakerName: 
    panelImage: {fileID: 0}
  - text: That mold... Why does it feel familiar?
    npcId: 5
    style: 1
    speakerName: 
    panelImage: {fileID: 0}
  - text: Artemis touches the mold. A thread of moonlight passes through its crack.
    npcId: 0
    style: 3
    speakerName: 
    panelImage: {fileID: 0}
  - text: When people forget, help them remember.
    npcId: 7
    style: 2
    speakerName: 
    panelImage: {fileID: 0}
  - text: Who said that?
    npcId: 5
    style: 1
    speakerName: 
    panelImage: {fileID: 0}
  - text: Hm? Did you hear something too, little one?
    npcId: 1
    style: 0
    speakerName: 
    panelImage: {fileID: 0}
