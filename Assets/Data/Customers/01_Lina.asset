  customerName: Lina Chen
  clues:
  - category: 0
    answer: 2
    memoryNote: Lina stole warm red bean paste from her father's spoon.
    hint: 'Tutorial: Choose the filling Lina named directly.'
    correction: Use red bean paste.
    wrongReaction: {fileID: 11400000, guid: fcba1fa68b6994647bbda6ab04b08c3e, type: 2}
    directHint: {fileID: 11400000, guid: 06f33f2116badb749a4101d1d946778d, type: 2}
  - category: 1
    answer: 4
    memoryNote: Her father left out the yolk she disliked.
    hint: 'Tutorial: Choose what her father deliberately left out.'
    correction: Leave out the salted yolk.
    wrongReaction: {fileID: 11400000, guid: 826a9e31acbbe39438f30efeedb4c221, type: 2}
    directHint: {fileID: 11400000, guid: 1d5fdac243a0d2d4bb01f69f60e5aa3b, type: 2}
  - category: 2
    answer: 5
    memoryNote: He reduced the sugar because he listened.
    hint: 'Tutorial: Match the sweetness to her memory.'
    correction: Choose less sugar.
